# graph - adjacency lists, traversal, and the questions they answer.
#
#   import graph
#
#   g = graph.from_edges([["alice", "bob"], ["bob", "dave"]])
#   graph.reachable(g, "alice")        # ["bob", "dave"]
#   graph.path(g, "alice", "dave")     # ["alice", "bob", "dave"]
#   graph.topo_sort(g)                 # dependencies before dependants
#
# Built for the small explicit graphs that turn up in application code:
# permission and delegation chains, dependency orders, category trees. Every
# edge counts as one hop - weights, A* and max-flow are `graph_algo`.
#
# Pure computation - no capabilities.
# `fail` is deliberately absent from this list. walk.ecko imports build.ecko
# and calls `build.fail`, so it has to stay exported there to cross the file
# boundary - but crossing a file boundary is not the same as being API, and a
# blanket `export *` here would publish it as `graph.fail`.
export { new, from_edges, add_node, add_edge, link, remove_edge, unlink, remove_node, has_node, has_edge, nodes, neighbors, edges, order, size, out_degree, in_degree, degree } from "./build.ecko"
export * from "./walk.ecko"

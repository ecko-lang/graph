# Traversing a graph, and the questions traversal answers.
#
# Neighbours arrive sorted (see build.ecko), so every order below is stable:
# the same graph gives the same walk every run, which is what makes these
# testable and their output diffable.
#
# Nothing here recurses. Every walk keeps its own queue or stack, so a long
# chain cannot reach the recursion limit, and "seen" sets are maps so a large
# graph is not quadratic in lookups.

import "./build.ecko"

## Returns the nodes in breadth-first order from `start`, `start` first.
##
## Layer by layer, so the order doubles as "how far away is each node", which
## is why `path` is built on the same walk rather than on `dfs`.
##
## errors: `graph`/`no_such_node` when `start` is not in the graph.
##
## example:
##   graph.bfs(g, "alice")
export fn bfs(g, start) {
    build.need_node("bfs", g, start)
    breadth_first(g, start)
}

fn breadth_first(g, start) {
    mut seen = {}
    seen[start] = true
    mut queue = [start]
    mut head = 0
    while head < len(queue) {
        node = queue[head]
        head += 1
        for n in build.neighbors(g, node) {
            unless n in seen {
                seen[n] = true
                queue = push(queue, n)
            }
        }
    }
    queue
}

## Returns the nodes in depth-first order from `start`, `start` first.
##
## errors: `graph`/`no_such_node` when `start` is not in the graph.
##
## example:
##   graph.dfs(g, "alice")
export fn dfs(g, start) {
    build.need_node("dfs", g, start)
    mut stack = [start]
    mut seen = {}
    mut out = []
    while len(stack) > 0 {
        node = last(stack)
        stack = take(stack, len(stack) - 1)
        unless node in seen {
            seen[node] = true
            out = push(out, node)
            # Pushed in reverse so the first neighbour is popped first, which
            # makes the walk match the sorted order rather than reverse it.
            for n in reverse(build.neighbors(g, node)) {
                unless n in seen { stack = push(stack, n) }
            }
        }
    }
    out
}

## Returns every node reachable from `start`, sorted, excluding `start` itself.
##
## The question it answers: who can approve this spend, directly or by
## delegation?
##
## errors: `graph`/`no_such_node` when `start` is not in the graph.
##
## example:
##   graph.reachable(g, "alice")
export fn reachable(g, start) {
    build.need_node("reachable", g, start)
    sort(filter(breadth_first(g, start), fn(n) n != start))
}

## Returns true when `src` can reach `dst` by following edges. A node always
## reaches itself.
##
## errors: `graph`/`no_such_node` when `src` or `dst` is not in the graph.
##
## example:
##   graph.connected(g, "alice", "erin")
export fn connected(g, src, dst) {
    build.need_node("connected", g, src)
    build.need_node("connected", g, dst)
    if src == dst { return true }
    contains(breadth_first(g, src), dst)
}

## Returns the fewest-hops path from `src` to `dst` as a list of nodes, or null
## when there is none.
##
## Breadth-first, so the first time `dst` is seen is by a shortest route. Every
## edge counts as one hop; there are no weights.
##
## errors: `graph`/`no_such_node` when `src` or `dst` is not in the graph.
##
## example:
##   graph.path(g, "alice", "erin")
export fn path(g, src, dst) = shortest("path", g, src, dst)

fn shortest(who, g, src, dst) {
    build.need_node(who, g, src)
    build.need_node(who, g, dst)
    if src == dst { return [src] }
    mut came_from = {}
    came_from[src] = src
    mut queue = [src]
    mut head = 0
    while head < len(queue) {
        node = queue[head]
        head += 1
        for n in build.neighbors(g, node) {
            unless n in came_from {
                came_from[n] = node
                if n == dst { return trace(came_from, src, dst) }
                queue = push(queue, n)
            }
        }
    }
    null
}

# Walk the came-from links backwards, then reverse.
fn trace(came_from, src, dst) {
    mut out = [dst]
    mut current = dst
    while current != src {
        current = came_from[current]
        out = push(out, current)
    }
    reverse(out)
}

## Returns the number of hops on the shortest path from `src` to `dst`, or null
## when `dst` is unreachable.
##
## errors: `graph`/`no_such_node` when `src` or `dst` is not in the graph.
##
## example:
##   graph.distance(g, "alice", "erin")
export fn distance(g, src, dst) {
    p = shortest("distance", g, src, dst)
    if is_null(p) { null } else { len(p) - 1 }
}

## Returns the connected components, each sorted, the list sorted by first
## member.
##
## On a directed graph these are the weakly connected components: edges are
## followed in both directions, so every node is in exactly one component.
##
## example:
##   graph.components(graph.from_edges([["a", "b"], ["c", "b"]]))   # [[a, b, c]]
export fn components(g) {
    # Both directions of every edge, so a directed graph gives weak components.
    mut both = {}
    for n in build.nodes(g) {
        both[n] = build.neighbors(g, n)
    }
    if g.directed {
        for src in build.nodes(g) {
            for dst in build.neighbors(g, src) {
                both[dst] = push(both[dst], src)
            }
        }
    }
    mut placed = {}
    mut out = []
    for start in build.nodes(g) {
        unless start in placed {
            placed[start] = true
            mut group = [start]
            mut head = 0
            while head < len(group) {
                node = group[head]
                head += 1
                for n in both[node] {
                    unless n in placed {
                        placed[n] = true
                        group = push(group, n)
                    }
                }
            }
            out = push(out, sort(group))
        }
    }
    # Starts are visited in sorted order and each start is its group's
    # smallest unplaced node, so the groups are already sorted by first member.
    out
}

## Returns true when the graph contains a cycle.
##
## On a directed graph that is a directed cycle, a self-loop included; a
## diamond is not one. On an undirected graph it is a closed walk that does not
## reuse an edge, so a single edge is not a cycle but a triangle or a self-loop
## is.
##
## example:
##   graph.has_cycle(graph.from_edges([["a", "b"], ["b", "a"]]))   # true
export fn has_cycle(g) {
    if g.directed { directed_cycle(g) } else { undirected_cycle(g) }
}

# Depth-first with three states: absent (unvisited), 1 (on the current path)
# and 2 (finished). An edge back to a node on the current path is a cycle; an
# edge to a finished node is a diamond, which is not. The stack holds
# [node, index of the next neighbour to try].
fn directed_cycle(g) {
    mut state = {}
    for root in build.nodes(g) {
        unless root in state {
            state[root] = 1
            mut stack = [[root, 0]]
            while len(stack) > 0 {
                top = last(stack)
                node = top[0]
                i = top[1]
                tos = build.neighbors(g, node)
                if i < len(tos) {
                    stack[len(stack) - 1] = [node, i + 1]
                    n = tos[i]
                    s = get(state, n)
                    if s == 1 { return true }
                    if s == null {
                        state[n] = 1
                        stack = push(stack, [n, 0])
                    }
                } else {
                    state[node] = 2
                    stack = take(stack, len(stack) - 1)
                }
            }
        }
    }
    false
}

# Depth-first, remembering the node each one was reached from. Meeting an
# already-visited node other than that parent closes a cycle. Edges are stored
# once per direction with no duplicates, so the parent edge is the only one to
# skip; a self-loop is its own cycle.
fn undirected_cycle(g) {
    mut parent = {}
    for root in build.nodes(g) {
        unless root in parent {
            parent[root] = null
            mut stack = [root]
            while len(stack) > 0 {
                node = last(stack)
                stack = take(stack, len(stack) - 1)
                for n in build.neighbors(g, node) {
                    if n == node { return true }
                    if n in parent { if n != parent[node] { return true } } else {
                        parent[n] = node
                        stack = push(stack, n)
                    }
                }
            }
        }
    }
    false
}

## Returns the nodes ordered so every edge points forwards.
##
## Kahn's algorithm: repeatedly take a node nothing points at. Ties are broken
## by taking the smallest ready node at each step, so the result is stable
## rather than merely valid. Linear in nodes plus edges, apart from keeping the
## ready list sorted.
##
## errors: `graph`/`cycle` when the graph has a cycle (a self-loop included);
## `bug`/`bad_argument` when the graph is undirected.
##
## example:
##   graph.topo_sort(graph.from_edges([["parse", "compile"], ["lex", "parse"]]))   # [lex, parse, compile]
export fn topo_sort(g) {
    unless g.directed {
        build.bad("bad_argument", "graph.topo_sort: a topological order needs a directed graph")
    }
    all = build.nodes(g)
    # Every in-degree is counted once, up front, and only decremented after.
    # Recounting them on every step made this cubic: 26 s for 600 nodes.
    mut indegree = {}
    for n in all {
        indegree[n] = 0
    }
    for src in all {
        for dst in build.neighbors(g, src) {
            indegree[dst] = indegree[dst] + 1
        }
    }
    mut ready = filter(all, fn(n) indegree[n] == 0)
    mut out = []
    while len(ready) > 0 {
        node = first(ready)
        ready = drop(ready, 1)
        out = push(out, node)
        mut freed = []
        for dst in build.neighbors(g, node) {
            left = indegree[dst] - 1
            indegree[dst] = left
            if left == 0 { freed = push(freed, dst) }
        }
        if len(freed) > 0 { ready = sort(flatten([ready, freed])) }
    }
    # Whatever never reached zero sits on a cycle.
    if len(out) < len(all) {
        build.fail(
            "cycle",
            "graph.topo_sort: the graph has a cycle, so no topological order exists",
        )
    }
    out
}
